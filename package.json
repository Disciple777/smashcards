{
  "name": "smashcards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Flashcard study app with hands-free audio study",
  "scripts": {
    "dev": "node --use-system-ca node_modules/vite/bin/vite.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\"",
    "lint:php": "node tools/phplint.mjs",
    "icons": "node tools/make-icons.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "deploy": "node tools/deploy.mjs",
    "check": "node tools/check.mjs",
    "migrate": "node tools/migrate.mjs && node tools/check.mjs"
  },
  "dependencies": {
    "basic-ftp": "^6.2.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "php-parser": "^3.7.0",
    "vite": "^8.2.1"
  }
}
