# Copy to .env.deploy and fill in. .env.deploy is gitignored and must stay that way.
#
# Never paste these values into a chat. The scripts read this file directly and
# never print its contents.

# --- FTP (hPanel -> Files -> FTP Accounts) ------------------------------------
FTP_HOST=ftp.guatermelon.com
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
# true = FTPS (explicit TLS on port 21). Leave true; plain FTP sends the
# password in cleartext across the network.
FTP_SECURE=true

# Path from the FTP login's home directory to the web root.
#
# On this account the FTP user already lands IN public_html, so this must be
# EMPTY. Setting it to /public_html creates a nested public_html inside the web
# root and silently deploys to a parallel copy of the site that nobody is
# looking at. The deploy prints the login home directory on connect — if it
# already ends in your web root, leave this blank.
FTP_REMOTE_ROOT=

# --- Where the app lives ------------------------------------------------------
API_BASE=https://guatermelon.com/smashcards/api
APP_BASE=https://guatermelon.com/smashcards

# --- Ops endpoint keys --------------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# The SAME values must go in api/config.php under 'ops' on the server.
MIGRATE_KEY=
OPS_KEY=
